<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF0E9">

    <FrameLayout
        android:id="@+id/navigation_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/navigation_edge_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false" />

    <LinearLayout
        android:id="@+id/navigation_top_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#F2FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navigation_close"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Close" />

            <TextView
                android:id="@+id/navigation_destination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#173B2B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navigation_external"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Maps" />

            <Button
                android:id="@+id/navigation_legal"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Legal" />
        </LinearLayout>

        <TextView
            android:id="@+id/navigation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:text="Preparing navigation…"
            android:textColor="#26382F"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navigation_overview"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:enabled="false"
                android:text="Overview" />

            <Button
                android:id="@+id/navigation_start"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="Start" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
