<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF0E9">

    <FrameLayout
        android:id="@+id/navigation_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/navigation_edge_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false" />

    <TextView
        android:id="@+id/navigation_guidance_destination"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="220dp"
        android:contentDescription="Current navigation destination"
        android:elevation="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="320dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="#173B2B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/navigation_top_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#F2FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/navigation_destination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#173B2B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/navigation_external"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="↗"
                android:textSize="21sp"
                android:contentDescription="Open in Google Maps" />

            <Button
                android:id="@+id/navigation_legal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="ⓘ"
                android:textSize="18sp"
                android:contentDescription="Navigation legal information" />

            <Button
                android:id="@+id/navigation_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="×"
                android:textSize="24sp"
                android:contentDescription="Close navigation" />
        </LinearLayout>

        <TextView
            android:id="@+id/navigation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:maxLines="2"
            android:text="Preparing navigation…"
            android:textColor="#26382F"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/navigation_top_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navigation_overview"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:enabled="false"
                android:text="Overview" />

            <Button
                android:id="@+id/navigation_start"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:text="Start" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
